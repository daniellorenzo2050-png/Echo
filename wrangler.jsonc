{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orangecloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "vars": {
    "ENVIRONMENT": "production"
  },
  "kv_namespaces": [
    {
      "binding": "ORANGE_SITES",
      "id": "73f840a801004c678665be5553b0ea7c"
    }
  ],
  "d1_databases": [
    {
      "binding": "ORANGE_DB",
      "database_name": "orangecloud-db",
      "database_id": "ac99a8d0-2b4b-44c4-99f8-a9efa2a2f3b5"
    }
  ]
}
