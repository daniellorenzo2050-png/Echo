{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echo",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "echo-db",
      "database_id": "ac99a8d0-2b4b-44c4-99f8-a9efa2a2f3b5"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "ECHO_KV",
      "id": "e1578b9bc66d4fc2956c4c8d732a1e8c"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ]
}
